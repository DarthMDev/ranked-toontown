struct SuitAttack {
  //   index of the attacking suit
  //   id of the suit's attack
  //   index of the target of the attack
  //   array of damages
  //   bit-field indicating indices of toons that have died from this attack
  //   flag indicating if this suit attacks before the toons this round
  int64 index;
  int64 attack;
  int64 target;
  int64[] damage;
  int64 toonDied;
  int64 beforeToons;
  int64 taunt;
};

struct ToonAttack {
  //   index of attacking toon
  //   attack track
  //   attack level
  //   index of the target (or doId if it's an SOS)
  //   array of damages
  //   accuracy bonus for the attack
  //   damage bonus for the attack
  //   array of knockback bonuses
  //   bit-field indicating indices of suits that have died from this attack
  int64 index;
  int64 track;
  int64 level;
  int64 target;
  int64[] hp;
  int64 accBonus;
  int64 hpBonus;
  int64[] kbBonus;
  int64 suitDied;
  int64 suitRevive;
};

struct BattleScene {
  int64 id;
  uint64 target;
  int64[] hp;
  uint64[] otherTargets;
  int64 isToon;
};

struct BattleMovie {
  //   flag indicating an empty movie
  //   array of toon doIds
  //   array of suit doIds
  int64 active;
  uint64[] activeToons;
  uint64[] activeSuits;
  
  ToonAttack[] toonAttacks;
  SuitAttack[] suitAttacks;
  BattleScene[] battleScenes;
};

