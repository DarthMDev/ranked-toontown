struct ArchipelagoInformation {
  uint32 avId;
  int16 slotId;
  int16 teamId;
};

struct ArchipelagoItem {
    int64 item;
    int64 location;
    int32 player;
    uint8 flags;
};

struct ArchipelagoHint {
    int16 destination;
    ArchipelagoItem item;
    string player_name;
    string location_name;
    bool found;
};

dclass DistributedArchipelagoManager : DistributedObject {
  sync(ArchipelagoInformation[]) required broadcast ram;
  requestHints() clsend airecv;
  setHints(ArchipelagoHint[]);
  addHint(ArchipelagoHint);
  addHints(ArchipelagoHint[]);
};

